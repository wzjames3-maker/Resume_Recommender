# ============================================================
# MaxKB 精简内核 + 人事招聘工作台 · 生产环境变量模板
# 用法：cp .env.example .env 后按环境填写；.env 权限必须为 600
# 本机开发配置见 HANDOFF.md §1.1
# ============================================================

# ---- 配置来源（必填）----
# ENV = 从环境变量读取（本模板）；否则从 /opt/maxkb/conf 读 YAML
MAXKB_CONFIG_TYPE=ENV

# ---- 数据库（必填）----
MAXKB_DB_NAME=maxkb
MAXKB_DB_HOST=127.0.0.1
MAXKB_DB_PORT=5432
MAXKB_DB_USER=postgres
MAXKB_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# 生产建议使用 dj_db_conn_pool.backends.postgresql（连接池）+ sslmode 参数
MAXKB_DB_ENGINE=dj_db_conn_pool.backends.postgresql
MAXKB_DB_MAX_OVERFLOW=80

# ---- Redis（必填）----
MAXKB_REDIS_HOST=127.0.0.1
MAXKB_REDIS_PORT=6379
MAXKB_REDIS_PASSWORD=
MAXKB_REDIS_DB=0
MAXKB_REDIS_MAX_CONNECTIONS=100

# ---- Django 安全（生产必改）----
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(50))"
MAXKB_SECRET_KEY=CHANGE_ME_RANDOM_50_CHARS
# 生产必须关闭
MAXKB_DEBUG=false

# ---- 对象存储（默认本地；生产建议 S3/MinIO）----
# local = 本地文件系统（data/ 目录，仅本机开发）
# s3   = S3 兼容对象存储（MinIO/OSS/COS 等）
MAXKB_STORAGE_BACKEND=local
MAXKB_S3_ENDPOINT=127.0.0.1:9000
MAXKB_S3_ACCESS_KEY=CHANGE_ME
MAXKB_S3_SECRET_KEY=CHANGE_ME
MAXKB_S3_BUCKET=maxkb
# true 时使用 https 访问对象存储
MAXKB_S3_SECURE=false

# ---- worker / 探针目录（生产 /opt/maxkb-app/tmp 有权限可省略）----
MAXKB_WORKER_TMP=/opt/maxkb-app/tmp

# ---- 日志（默认 PROJECT_DIR/logs）----
MAXKB_LOG_DIR=/opt/maxkb-app/logs

# ---- 备份（installer/backup.sh 使用，独立于数据库口令）----
# BACKUP_PASSPHRASE 不进 .env 也可，部署时单独注入更安全
BACKUP_PASSPHRASE=CHANGE_ME_BACKUP_KEY
BACKUP_DIR=/opt/maxkb-app/backups
