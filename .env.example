# 智能招聘 RAG 推荐系统 - 环境变量配置示例
# 复制此文件为 .env 并填写实际值
# 注意: 本文件不含真实密钥，切勿写入 sk- 等敏感值

# ==================== 应用配置 ====================
APP_NAME=resume-rag
APP_ENV=dev
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:8501

# ==================== PII 加密 ====================
# 生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=<your-fernet-key-here>

# ==================== LLM 配置 ====================
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=<your-deepseek-api-key>
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ==================== OCR 配置 ====================
OCR_API_KEY=<your-ocr-api-key>

# ==================== Embedding 配置 ====================
EMBEDDING_PROVIDER=bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=<your-embedding-api-key>
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_DIMENSION=1024

# ==================== Reranker 配置 ====================
RERANKER_API_KEY=<your-reranker-api-key>
RERANKER_BASE_URL=https://api.siliconflow.cn/v1

# ==================== Milvus 配置 ====================
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION_PREFIX=resume_
MILVUS_DIMENSION=1024
MILVUS_VERSION_COMPAT=2.4
MILVUS_PORT=19530

# ==================== MongoDB 配置 ====================
MONGODB_URL=mongodb://localhost:27017
MONGODB_USER=admin
MONGODB_PASSWORD=<your-mongodb-password>
MONGODB_DATABASE=resume_rag
MONGODB_AUTH_SOURCE=admin
MONGODB_PORT=27017

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=<your-redis-password>

# ==================== ARQ 队列配置 ====================
QUEUE_NAME=resume-rag
QUEUE_MAX_JOBS=10
QUEUE_RETRY=3
QUEUE_JOB_TIMEOUT=300
QUEUE_RESULT_EXPIRATION=3600

# ==================== JWT 配置 ====================
JWT_SECRET_KEY=<your-jwt-secret-key>
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ==================== 其他配置 ====================
LOG_LEVEL=INFO
STREAMLIT_PORT=8501
