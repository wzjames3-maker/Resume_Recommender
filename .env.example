# 智能招聘 RAG 推荐系统 — 环境变量配置 (生产模板)
# 复制: cp .env.example .env
# 生成密钥: python -c "import secrets; print(secrets.token_hex(32))"
# 生成 Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ==================== 应用配置 ====================
APP_NAME=resume-rag
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost,http://127.0.0.1
LOG_LEVEL=INFO

# ==================== Nginx 代理端口 ====================
NGINX_PORT=80

# ==================== LLM 配置 ====================
LLM_PROVIDER=sensenova
LLM_MODEL=sensenova-6.7-flash-lite
LLM_API_KEY=<your-llm-api-key>
LLM_BASE_URL=https://token.sensenova.cn/v1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192

# ==================== OCR 配置 ====================
OCR_PROVIDER=siliconflow
OCR_MODEL=deepseek-ai/DeepSeek-OCR
OCR_API_KEY=<your-ocr-api-key>
OCR_BASE_URL=https://api.siliconflow.cn/v1

# ==================== Embedding 配置 ====================
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=<your-embedding-api-key>
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_DIMENSION=1024
EMBEDDING_MODEL_PATH=/app/models/bge-m3

# ==================== Reranker 配置 ====================
RERANKER_PROVIDER=siliconflow
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_API_KEY=<your-reranker-api-key>
RERANKER_BASE_URL=https://api.siliconflow.cn/v1

# ==================== Milvus 向量库 ====================
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
MILVUS_COLLECTION_PREFIX=resume_
MILVUS_DIMENSION=1024
MILVUS_VERSION_COMPAT=2.4

# ==================== MongoDB 文档库 ====================
MONGODB_URL=mongodb://mongodb:27017
MONGODB_USER=admin
MONGODB_PASSWORD=<generate-strong-password>
MONGODB_DATABASE=resume_rag
MONGODB_AUTH_SOURCE=admin

# ==================== Redis 缓存/队列 ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=<generate-strong-password>

# ==================== ARQ 任务队列 ====================
QUEUE_NAME=resume-rag
QUEUE_MAX_JOBS=10
QUEUE_RETRY=3
QUEUE_JOB_TIMEOUT=300
QUEUE_RESULT_EXPIRATION=3600

# ==================== JWT 认证 ====================
# 生成: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=<generate-random-64-byte-hex>
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ==================== PII 加密 (独立密钥, 勿复用 JWT) ====================
# 生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=<generate-fernet-key>

# ==================== MinIO 存储 (Milvus 依赖) ====================
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=<generate-strong-password>

# ==================== 预留: FlagEmbedding 本地模型路径 ====================
# EMBEDDING_MODEL_PATH=/app/models/bge-m3
